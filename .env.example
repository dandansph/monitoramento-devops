# Copie para server/.env e ajuste
PORT=4000
DEMO_TARGET_PORT=4100

# Login do painel
ADMIN_USER=admin
ADMIN_PASSWORD=redes2026
JWT_SECRET=troque-este-segredo

# Chave para agentes externos enviarem métricas em POST /api/ingest
INGEST_API_KEY=chave-de-ingestao-demo

# Alvos reais monitorados
HTTP_TARGETS=https://www.google.com,https://www.idp.edu.br
DNS_SERVERS=8.8.8.8,1.1.1.1
DNS_NAMES=google.com,idp.edu.br,github.com
SMTP_PROBE_HOST=smtp.gmail.com
SMTP_PROBE_PORT=587

# Envio de alertas por e-mail.
# Se SMTP_HOST ficar vazio, usa uma conta de teste Ethereal (o link de preview aparece no painel).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM="PixelNOC <alertas@pixelnoc.local>"
ALERT_EMAIL_TO=equipe@exemplo.com
